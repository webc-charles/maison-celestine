{%- assign image_alt = card_product.featured_image.alt | default: card_product.title -%}
<article class="knr-product-card">
  <div class="knr-product-card__media">
    <a class="knr-product-card__link" href="{{ card_product.url }}">
      {%- if card_product.featured_image -%}
        {{
          card_product.featured_image
          | image_url: width: 480
          | image_tag: widths: '160, 320, 480', alt: image_alt, class: 'knr-product-card__image'
        }}
      {%- endif -%}
    </a>
    {%- assign card_variant = card_product.selected_or_first_available_variant -%}
    {%- if card_variant.available -%}
      <product-form-component
        class="knr-product-card__add"
        data-section-id="{{ section.id }}"
        data-product-id="{{ card_product.id }}"
        on:submit="/handleSubmit"
      >
        <div class="knr-visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {%- form 'product', card_product, data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ card_variant.id }}">
          <add-to-cart-component ref="addToCartButtonContainer">
            <button
              class="knr-product-card__button"
              type="submit"
              name="add"
              ref="addToCartButton"
              on:click="/handleClick"
              data-knr-cart-button
              aria-label="{{ card_product.title | escape }}"
            >
              {% render 'knr-icon', name: 'plus', size: 9 %}
            </button>
          </add-to-cart-component>
        {%- endform -%}
      </product-form-component>
    {%- endif -%}
  </div>
  <div class="knr-product-card__info">
    <a class="knr-product-card__name" href="{{ card_product.url }}">{{ card_product.title }}</a>
    <p class="knr-product-card__price">{{ card_product.price | money }}</p>
  </div>
</article>
