{%- liquid
  assign free = false
  if item.final_line_price == 0
    assign free = true
  endif

  assign rating = item.product.metafields.reviews.rating.value.rating | times: 1.0 | round: 1
  assign rating_count = item.product.metafields.reviews.rating_count.value
  assign reviews = rating_label | replace: '[count]', rating_count

  assign media_alt = item.image.alt | default: item.product.title
-%}

<article
  class="knr-cart-line{% if free %} knr-cart-line--free{% endif %}"
  data-knr-cart-line
  data-key="{{ item.key }}"
>
  <div class="knr-cart-line__media">
    {%- if item.image -%}
      {{
        item.image
        | image_url: width: 160
        | image_tag: widths: '80, 160', alt: media_alt, class: 'knr-cart-line__image'
      }}
    {%- endif -%}
  </div>

  <div class="knr-cart-line__body">
    <div class="knr-cart-line__top">
      {%- if rating_count > 0 -%}
        {% render 'knr-rating', score: rating, label: reviews %}
      {%- endif -%}

      <p class="knr-cart-line__price" data-knr-cart-price data-unit="{{ item.final_price }}">
        {%- if free -%}
          {{ gift_label }}
        {%- else -%}
          {{ item.final_line_price | money }}
        {%- endif -%}
      </p>
    </div>

    <h3 class="knr-cart-line__title">
      <a class="knr-cart-line__link" href="{{ item.url }}">{{ item.product.title }}</a>
    </h3>

    {%- if item.variant.title != 'Default Title' -%}
      <p class="knr-cart-line__variant">{{ item.variant.title }}</p>
    {%- endif -%}

    {%- unless free -%}
      <div class="knr-cart-line__actions">
        <div class="knr-cart-line__quantity">
          <button
            class="knr-button knr-button--ghost knr-button--small knr-button--square"
            type="button"
            aria-label="{{ decrease_label | escape }}"
            data-knr-cart-quantity="-1"
            {% if item.quantity <= 1 %}disabled{% endif %}
          >
            {% render 'knr-icon', name: 'minus', size: 10 %}
          </button>

          <span class="knr-cart-line__count" data-knr-cart-line-count aria-live="polite">{{ item.quantity }}</span>

          <button
            class="knr-button knr-button--ghost knr-button--small knr-button--square"
            type="button"
            aria-label="{{ increase_label | escape }}"
            data-knr-cart-quantity="1"
          >
            {% render 'knr-icon', name: 'plus', size: 10 %}
          </button>
        </div>

        <button class="knr-cart-line__remove" type="button" data-knr-cart-remove>{{ remove_label }}</button>
      </div>
    {%- endunless -%}
  </div>
</article>
