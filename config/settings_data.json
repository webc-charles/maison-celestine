      "knr-faq": {
        "type": "knr-faq",
        "blocks": {
          "faq-f1": {
            "type": "question",
            "settings": {
              "question": "Comment utiliser ?",
              "answer": "<p>Appliquez 3 à 5 gouttes le soir sur visage et cou préalablement nettoyés. Massez délicatement en mouvements ascendants jusqu'à absorption complète. Peut s'utiliser seul ou sous votre crème habituelle.</p>"
            }
          },
          "faq-f2": {
            "type": "question",
            "settings": {
              "question": "Quand voir les effets ?",
              "answer": "<p>Les premiers effets sur l'éclat apparaissent dès la deuxième semaine. L'atténuation des ridules se mesure à partir de la quatrième semaine, et la densité cutanée à douze semaines.</p>"
            }
          },
          "faq-f3": {
            "type": "question",
            "settings": {
              "question": "Convient-il à tous ?",
              "answer": "<p>Oui, y compris aux peaux sensibles. Le rétinol végétal issu du bakuchiol ne provoque pas la photosensibilité du rétinol classique. En cas de doute, testez au pli du coude.</p>"
            }
          },
          "faq-f4": {
            "type": "question",
            "settings": {
              "question": "Est-il naturel ?",
              "answer": "<p>97 % des ingrédients sont d'origine naturelle. La formule est certifiée COSMOS ORGANIC par ECOCERT Greenlife, sans parfum de synthèse ni conservateur controversé.</p>"
            }
          },
          "faq-f5": {
            "type": "question",
            "settings": {
              "question": "Peut-on l'associer ?",
              "answer": "<p>Il s'associe à la Crème Régénérante le soir et au Sérum Éclat le matin. Évitez l'application simultanée avec un autre rétinoïde ou un acide exfoliant fort.</p>"
            }
          }
        },
        "block_order": [
          "faq-f1",
          "faq-f2",
          "faq-f3",
          "faq-f4",
          "faq-f5"
        ],
