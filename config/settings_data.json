              "number": "02",
              "title": "Découvrir",
              "text": "<p>Éclat et uniformité retrouvés. Cible les taches et les irrégularités de grain de peau.</p>",
              "link_label": "Lire plus",
              "url": "/products/serum-eclat"
            }
          },
